{
  "name": "@jcautoimport/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JC Autoimport — aplicación de escritorio",
  "main": "dist/main/main.js",
  "author": {
    "name": "JC Autoimport",
    "email": "ventas@jcautoimport.com"
  },
  "homepage": "https://jcautoimport.com",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron dist/main/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  }
}
