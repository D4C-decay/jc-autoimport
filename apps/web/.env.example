# ===========================================
# JC AUTOIMPORT - WEB ENVIRONMENT
# ===========================================

# API privada (solo servidor: proxy /backend y SSR).
API_INTERNAL_URL=http://localhost:3000

# URL pública del sitio. Necesaria para que los enlaces de Supabase vuelvan
# al dominio correcto (producción: https://jcautoimport.com).
NEXT_PUBLIC_SITE_URL=http://localhost:4200

# Supabase Auth. La anon key es pública; RLS deny-all impide leer datos.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
