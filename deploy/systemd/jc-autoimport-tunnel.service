[Unit]
Description=JC Autoimport public tunnel (Cloudflare)
After=network-online.target jc-autoimport-web.service
Wants=network-online.target jc-autoimport-web.service

[Service]
Type=simple
User=%RUN_USER%
Group=%RUN_GROUP%
Environment=HOME=%RUN_USER_HOME%
# Outbound only: Cloudflare dials us, so no port has to be open on the router
# and the firewall can stay closed.
ExecStart=%CLOUDFLARED_BIN% tunnel --url http://127.0.0.1:4200 --no-autoupdate
Restart=always
RestartSec=10
StandardOutput=append:%LOG_DIR%/tunnel.log
StandardError=append:%LOG_DIR%/tunnel.log

[Install]
WantedBy=multi-user.target
