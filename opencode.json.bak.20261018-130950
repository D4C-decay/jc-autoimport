{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "MEMORY.md"
  ],
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "qwen2.5:7b",
          "tool_call": true
        },
        "qwen2.5-coder:14b": {
          "name": "qwen2.5-coder:14b",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.local/state/jcautoimport/**": "allow",
      "~/.cache/ms-playwright/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--cdp-endpoint",
        "http://localhost:9222"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--browserUrl",
        "http://localhost:9222"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.4.2"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp-postgres.sh"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 60000
  }
}
