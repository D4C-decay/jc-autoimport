# ===========================================
# JC AUTOIMPORT - BACKEND ENVIRONMENT
# ===========================================

# Application
NODE_ENV=development
PORT=3000
# Interface to bind: 127.0.0.1 keeps the API off the local network
API_HOST=0.0.0.0
APP_NAME=jc-autoimport-backend
APP_URL=http://localhost:3000
# URL pública de la web (para enlaces enviados por correo, p. ej. confirmación)
WEB_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://jcauto:jcauto_password@localhost:5432/jcautoimport?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace_with_a_very_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_very_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encriptación de PII en reposo (AES-256-GCM).
# 64 caracteres hexadecimales (32 bytes) o cualquier frase (se hace hash a 32 bytes).
DATA_ENCRYPTION_KEY=replace_with_64_char_hex_openssl_rand_hex_32

# Password hashing (Argon2)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# AWS S3 (Media Storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jc-autoimport-media
AWS_S3_ENDPOINT=

# Cloudinary (optional media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=USD

# Email
# Remitente visible en los correos
EMAIL_FROM=no-reply@jcautoimport.com
# Opcion A (recomendada): SMTP (Gmail con contrasena de aplicacion).
# Si SMTP_HOST esta definido se usa SMTP; si no, se intenta Resend; si tampoco,
# el correo se escribe en el log (solo desarrollo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
# Opcion B: Resend (API HTTP)
RESEND_API_KEY=

# WhatsApp
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Sentry
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=120
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_LIMIT=5
